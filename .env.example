# Complete the QR authentication flow on first run; the example stores its refresh token in .env.
# Keep .env private. It is ignored by git.
STEAM_ACCOUNT_NAME=
STEAM_REFRESH_TOKEN=

# Optional: SteamID64 to send a friend request to immediately after login.
STEAM_TEST_FRIEND_STEAMID=

# Optional: message sent after the bot accepts an incoming friend request.
STEAM_WELCOME_MESSAGE=

# Optional: image (png, jpeg, gif, webp) the bot sends when a friend writes !bild.
STEAM_IMAGE_PATH=
